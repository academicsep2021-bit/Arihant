local function makeBtn(text, order, callback, toggle)
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(1,-10,0,25)
    btn.Position = UDim2.new(0,5,0,order*30)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(0,255,0)
    btn.BackgroundColor3 = toggle and Color3.fromRGB(150,0,0) or Color3.fromRGB(0,0,0)
    btn.MouseButton1Click:Connect(function() callback(btn) end)
end

