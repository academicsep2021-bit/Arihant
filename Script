    if uiOpen then
        frame.Visible = true
        tweenService:Create(frame,TweenInfo.new(0.3),{Position = UDim2.new(0.5,-90,0.5,-150)}):Play()
    else
        local t = tweenService:Create(frame,TweenInfo.new(0.3),{Position = UDim2.new(0.5,-90,1,0)})
