--// ESP
-- Objects are reused instead of recreated every frame.
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP"
espFolder.Parent = gui

local espObjects = {}

local function removeESP(plr)
    local data = espObjects[plr]

    if data then
        if data.highlight then
            data.highlight:Destroy()
        end

        if data.box then
            data.box:Destroy()
        end

        if data.billboard then
            data.billboard:Destroy()
        end

        espObjects[plr] = nil
    end
end

local function createESP(plr)
    if plr == player then
        return
    end

    if espObjects[plr] then
        return espObjects[plr]
    end

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = espFolder

    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(6,8,4)
    box.Transparency = 0.4
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Parent = espFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0,160,0,60)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1,0,1,0)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.Code
    text.TextScaled = true
    text.TextStrokeTransparency = 0.5
    text.Parent = billboard

    local data = {
        highlight = highlight,
        box = box,
        billboard = billboard,
        text = text
    }

    espObjects[plr] = data

    return data
end

local function updateESP()
    local myCharacter = player.Character
    local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if not myHRP then
        return
    end

    local activePlayers = {}

    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= player then
            activePlayers[plr] = true

            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if hrp then
                local data = createESP(plr)

                local color =
                    plr.Team
                    and plr.Team.TeamColor.Color
                    or Color3.fromRGB(0,255,0)

                -- Same team color for everything
                data.highlight.Adornee = char
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color

                data.box.Adornee = hrp
                data.box.Color3 = color

                if head then
                    data.billboard.Adornee = head

                    local distance =
                        (hrp.Position - myHRP.Position).Magnitude

                    local hp =
                        humanoid and humanoid.Health or 0

                    data.text.TextColor3 = color

                    data.text.Text =
                        plr.Name ..
                        "\nHP: " .. math.floor(hp) ..
                        "\nDist: " .. math.floor(distance)
                else
                    data.billboard.Adornee = nil
                end
            else
                local data = espObjects[plr]

                if data then
                    data.highlight.Adornee = nil
                    data.box.Adornee = nil
                    data.billboard.Adornee = nil
                end
            end
        end
    end

    -- Remove ESP for players who left
    for plr in pairs(espObjects) do
        if not activePlayers[plr] then
            removeESP(plr)
        end
    end
end

players.PlayerRemoving:Connect(removeESP)

-- Update ESP only several times per second instead of every frame.
runService.Heartbeat:Connect(function(dt)
    espTimer += dt

    if espTimer >= ESP_UPDATE_RATE then
        espTimer = 0
        updateESP()
    end
end)

--// AIMBOT
local function getTarget()
    local cam = workspace.CurrentCamera
    local closest
    local shortest = aimFOV

    for _, plr in ipairs(players:GetPlayers()) do
        if plr ~= player
            and plr.Character
            and plr.Character:FindFirstChild("Head") then

            local head = plr.Character.Head
            local offset = head.Position - cam.CFrame.Position

            if offset.Magnitude > 0 then
                local dir = offset.Unit

                local dot =
                    math.clamp(
                        cam.CFrame.LookVector:Dot(dir),
                        -1,
                        1
                    )

                local angle = math.deg(math.acos(dot))

                if angle < shortest then
                    shortest = angle
                    closest = plr
                end
            end
        end
    end

    return closest
end

runService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local target = getTarget()

        if target
            and target.Character
            and target.Character:FindFirstChild("Head") then

            local cam = workspace.CurrentCamera

            local newCF =
                CFrame.new(
                    cam.CFrame.Position,
                    target.Character.Head.Position
                )

            cam.CFrame =
                cam.CFrame:Lerp(newCF, aimSpeed)
        end
    end
end)

--// FEATURES
local function setToggleColor(btn, state)
    btn.BackgroundColor3 =
        state
        and Color3.fromRGB(0,150,0)
        or Color3.fromRGB(150,0,0)
end

--// FLY
local function toggleFly(btn)
    flying = not flying

    if flying then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e6,1e6,1e6)
        bodyVelocity.P = 1e4
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = getHRP()
    else
        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end
    end

    setToggleColor(btn, flying)
end

-- Camera-direction flying
runService.RenderStepped:Connect(function()
    if flying and bodyVelocity then
        local camera = workspace.CurrentCamera

        bodyVelocity.Velocity =
            camera.CFrame.LookVector * currentSpeed
    end
end)

--// FULLBRIGHT
local originalBrightness = lighting.Brightness

local function toggleFullBright(btn)
    fullBright = not fullBright

    if fullBright then
        lighting.Brightness = 2
    else
        lighting.Brightness = originalBrightness
    end

    setToggleColor(btn, fullBright)
end

--// NOCLIP
local function toggleNoclip(btn)
    noclip = not noclip

    local char = player.Character

    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not noclip
            end
        end
    end

    setToggleColor(btn, noclip)
end

runService.Stepped:Connect(function()
    if not noclip then
        return
    end

    local char = player.Character

    if not char then
        return
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end)

--// SHIFT LOCK
local function toggleShiftLock(btn)
    shiftLockEnabled = not shiftLockEnabled

    local humanoid = getHumanoid()

    if shiftLockEnabled then
        humanoid.AutoRotate = false
    else
        humanoid.AutoRotate = true
    end

    setToggleColor(btn, shiftLockEnabled)
end

-- Mobile-compatible shift lock
runService.RenderStepped:Connect(function()
    if not shiftLockEnabled then
        return
    end

    local char = player.Character

    if not char then
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera

    if not humanoid or not hrp or not camera then
        return
    end

    humanoid.AutoRotate = false

    -- Keep the character facing the camera's horizontal direction.
    local look = camera.CFrame.LookVector
    local flatLook = Vector3.new(look.X,0,look.Z)

    if flatLook.Magnitude > 0.01 then
        flatLook = flatLook.Unit

        hrp.CFrame =
            CFrame.lookAt(
                hrp.Position,
                hrp.Position + flatLook
            )
    end
end)

--// AIMBOT TOGGLE
local function toggleAimbot(btn)
    aimbotEnabled = not aimbotEnabled
    setToggleColor(btn, aimbotEnabled)
end

--// SPEED
local function setSpeedAdd()
    currentSpeed += 5

    local humanoid = getHumanoid()
    humanoid.WalkSpeed = currentSpeed
end

local function setSpeedSub()
    currentSpeed -= 5

    if currentSpeed < 0 then
        currentSpeed = 0
    end

    local humanoid = getHumanoid()
    humanoid.WalkSpeed = currentSpeed
end

--// JUMP
local function setJumpAdd()
    currentJump += 10

    local humanoid = getHumanoid()
    humanoid.UseJumpPower = true
    humanoid.JumpPower = currentJump
end

local function setJumpSub()
    currentJump -= 10

    if currentJump < 0 then
        currentJump = 0
    end

    local humanoid = getHumanoid()
    humanoid.UseJumpPower = true
    humanoid.JumpPower = currentJump
end

